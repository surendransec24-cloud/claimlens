# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Database & Storage
DATABASE_URL=sqlite:///./claimlens.db
UPLOAD_DIR=./uploads

# Authentication & Security (Requirement: min 32-character high entropy key)
JWT_SECRET=replace_with_at_least_32_character_random_secret_key_here

# Demo Staff Passwords (used by seed_users.py - min 10 chars, non-trivial)
DEMO_ADJUSTER_PASSWORD=AdjusterSecurePass1!
DEMO_SUPERVISOR_PASSWORD=SupervisorSecurePass1!
DEMO_ADMIN_PASSWORD=AdminSecurePass1!
